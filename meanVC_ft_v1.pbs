#!/bin/bash
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=48:00:00
#PBS -M z5327748@ad.unsw.edu.au
#PBS -m abe
#PBS -j oe
#PBS -N meanVC_ft_v1
#PBS -o meanVC_ft_v1.log

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
echo "Job started at: $(date)  Job ID: ${PBS_JOBID:-unknown}  Host: $(hostname)"

CONFIG_PATH="${CONFIG_PATH:-configs/meanVC_ft_v1.yaml}"
RUNTIME_CONFIG_PATH="${RUNTIME_CONFIG_PATH:-${TMPDIR:-/tmp}/meanVC_ft_v1.${PBS_JOBID:-$$}.yaml}"
CONDA_ENV="${CONDA_ENV:-sapc2}"
CONDA_ROOT="${CONDA_ROOT:-${HOME}/miniconda3}"

TRAIN_DEVICES="${TRAIN_DEVICES:-1}"
TRAIN_NUM_WORKERS="${TRAIN_NUM_WORKERS:-4}"
TRAIN_EPOCHS="${TRAIN_EPOCHS:-}"
PREPARE_ONLY="${PREPARE_ONLY:-0}"
TRAIN_ONLY="${TRAIN_ONLY:-0}"

module load python/3.10.8
module load ffmpeg/7.0.2
module load cuda/12.1.1

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
else
  source "${CONDA_ROOT}/etc/profile.d/conda.sh"
fi
conda activate "${CONDA_ENV}"

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export NCCL_ASYNC_ERROR_HANDLING="${NCCL_ASYNC_ERROR_HANDLING:-1}"
export TORCH_NCCL_BLOCKING_WAIT="${TORCH_NCCL_BLOCKING_WAIT:-1}"
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

python - "${CONFIG_PATH}" "${RUNTIME_CONFIG_PATH}" "${TRAIN_DEVICES}" "${TRAIN_NUM_WORKERS}" "${TRAIN_EPOCHS}" <<'PY'
import sys
from pathlib import Path
import yaml

src, dst, devices, num_workers, epochs = sys.argv[1:6]
src_p = Path(src).expanduser().resolve()
dst_p = Path(dst).expanduser().resolve()

with src_p.open("r", encoding="utf-8") as f:
    cfg = yaml.safe_load(f)

cfg.setdefault("user_settings", {})
cfg.setdefault("train", {}).setdefault("args", {})
cfg["user_settings"]["devices"] = int(devices)
cfg["user_settings"]["num_workers"] = int(num_workers)
cfg["train"]["args"]["num_workers"] = int(num_workers)
if epochs.strip():
    cfg["train"]["args"]["epochs"] = int(float(epochs))

dst_p.parent.mkdir(parents=True, exist_ok=True)
with dst_p.open("w", encoding="utf-8") as f:
    yaml.safe_dump(cfg, f, sort_keys=False)

print(f"[INFO] Wrote runtime config: {dst_p}")
print(f"[INFO] user_settings.devices={cfg['user_settings']['devices']}")
print(f"[INFO] user_settings.num_workers={cfg['user_settings']['num_workers']}")
print(f"[INFO] train.args.epochs={cfg['train']['args'].get('epochs')}")
PY

RUN_ARGS=()
if [[ "${PREPARE_ONLY}" == "1" ]]; then
  RUN_ARGS+=(--prepare-only)
fi
if [[ "${TRAIN_ONLY}" == "1" ]]; then
  RUN_ARGS+=(--train-only)
fi

python src/train/finetune_meanvc_hf.py --config "${RUNTIME_CONFIG_PATH}" "${RUN_ARGS[@]}"
rm -f "${RUNTIME_CONFIG_PATH}" || true

echo "Job finished at: $(date)"
